# Copia este archivo como .env y completa los valores. Nunca subas el .env real a Git.
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
# True solo en desarrollo. En producción: False.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En producción con dominio propio, por ejemplo: https://midominio.cl
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_COOKIES=True
DJANGO_SSL_REDIRECT=False

# Base de datos: sqlite (por defecto) o postgresql
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Correo (contraseña de aplicación de Gmail)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Nombre que ve el cliente como remitente.
EMAIL_FROM_NAME=Entre Platos y Copas
